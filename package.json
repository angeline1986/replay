{
  "name": "replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "replay": "./bin/replay.mjs" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:terminal-auth": "node --experimental-strip-types --test tests/integration/terminal-auth.test.ts",
    "check:lines": "node scripts/check-file-length.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run check:lines && npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run build",
    "collect": "node --experimental-strip-types collector/jobs/main.ts",
    "probe:youtube": "node --experimental-strip-types scripts/probe-youtube.ts",
    "replay": "node --experimental-strip-types cli/main.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.15.30",
    "jsdom": "26.1.0",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
